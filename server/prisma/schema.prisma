generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String?
  avatar    String?
  role      String   @default("STUDENT") // STUDENT | TEACHER | ADMIN

  // OAuth provider info (primary login)
  provider   String  // "google" | "github"
  providerId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  connectedAccounts ConnectedAccount[]
  workspaces        Workspace[]
  assignments       Assignment[]
  submissions       Submission[]
  classrooms        Classroom[]
  classroomMembers  ClassroomMember[]

  @@unique([provider, providerId])
}

model ConnectedAccount {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  provider     String   // "github" | "google"
  providerId   String
  accessToken  String   // Encrypted
  refreshToken String?  // Encrypted
  username     String?
  avatarUrl    String?
  scope        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@unique([provider, providerId])
}

model Workspace {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  language    String?
  template    String?  // blank | dsa | static-web | react | nextjs | nodejs | fullstack
  visibility  String   @default("private") // private | public
  repoUrl     String?
  repoName    String?
  isImported  Boolean  @default(false)
  status      String   @default("active") // active | archived

  userId    String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Assignment {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  type        String    @default("WEB_DEV") // WEB_DEV | DSA
  difficulty  String    @default("MEDIUM")  // EASY | MEDIUM | HARD
  template    String?   // react | nextjs | nodejs | vite-react-ts | null (for DSA)
  starterCode String?   // JSON: { "filename": "content", ... }
  language    String?   // For DSA: cpp | python | java
  timeLimit   Int?      // Minutes allowed to complete
  deadline    DateTime?
  maxMarks    Int       @default(100)
  aiAllowed   Boolean   @default(false)

  classroomId String    @db.ObjectId
  createdBy   String    @db.ObjectId
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  classroom   Classroom  @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  creator     User       @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  testCases   TestCase[]
  submissions Submission[]
}

model TestCase {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  assignmentId   String @db.ObjectId
  input          String
  expectedOutput String
  weight         Int    @default(1) // Marks weight for this test case
  isHidden       Boolean @default(false)

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}

model Submission {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  assignmentId String    @db.ObjectId
  studentId    String    @db.ObjectId
  workspaceId  String?   @db.ObjectId
  code         String?   // Snapshot of submitted code (for DSA)
  score        Int?
  feedback     String?
  status       String    @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED | GRADED | TIMED_OUT
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Classroom {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  joinCode    String   @unique
  teacherId   String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     User               @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  members     ClassroomMember[]
  assignments Assignment[]
}

model ClassroomMember {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  classroomId String   @db.ObjectId
  userId      String   @db.ObjectId
  role        String   @default("STUDENT") // STUDENT | TEACHER
  joinedAt    DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classroomId, userId])
}
