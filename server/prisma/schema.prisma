generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String?
  avatar    String?
  role      String   @default("STUDENT") // STUDENT | TEACHER | ADMIN

  // OAuth provider info (primary login)
  provider   String  // "google" | "github"
  providerId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  connectedAccounts ConnectedAccount[]
  workspaces        Workspace[]
  assignments       Assignment[]

  @@unique([provider, providerId])
}

model ConnectedAccount {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  provider     String   // "github" | "google"
  providerId   String
  accessToken  String   // Encrypted
  refreshToken String?  // Encrypted
  username     String?
  avatarUrl    String?
  scope        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@unique([provider, providerId])
}

model Workspace {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  language    String?
  template    String?  // blank | dsa | static-web | react | nextjs | nodejs | fullstack
  visibility  String   @default("private") // private | public
  repoUrl     String?
  repoName    String?
  isImported  Boolean  @default(false)
  status      String   @default("active") // active | archived

  userId    String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Assignment {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  dueDate     DateTime?
  status      String    @default("pending") // pending | submitted | graded

  userId    String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
